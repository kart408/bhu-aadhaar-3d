{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "site.css", "use": "@vercel/static" },
    { "src": "apps/**", "use": "@vercel/static" },
    { "src": "packages/web/**", "use": "@vercel/static" },
    { "src": "data/generated/**", "use": "@vercel/static" }
  ],
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py?path=:path*"
    }
  ],
  "headers": [
    {
      "source": "/apps/verify/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
